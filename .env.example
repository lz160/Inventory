# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# IMS External SQL Server Configuration (SKLAD & SaleData)
# ------------------------------------------------------------------
MSSQL_SKLAD_SERVER=""
MSSQL_SKLAD_PORT="1433"
MSSQL_SKLAD_USER=""
MSSQL_SKLAD_PASSWORD=""
MSSQL_SKLAD_DATABASE="SKLAD"

MSSQL_SALEDATA_SERVER=""
MSSQL_SALEDATA_PORT="1433"
MSSQL_SALEDATA_USER=""
MSSQL_SALEDATA_PASSWORD=""
MSSQL_SALEDATA_DATABASE="SaleData"

# Pool & TLS settings (encrypt=false for internal WireGuard VPN tunnel)
MSSQL_POOL_MAX="10"
MSSQL_REQUEST_TIMEOUT_MS="30000"
MSSQL_ENCRYPT="false"
MSSQL_TRUST_SERVER_CERTIFICATE="true"

# Local SQLite database path for product category metadata (categories & product_meta)
IMS_META_DB_PATH="./data/ims_meta.db"

# Test / Sandbox driver override (set to "sqlite-seed" ONLY for local/CI integration testing without MSSQL)
# IMS_DB_MODE="sqlite-seed"

# Hetzner production persistence (database logins separate by store).
# Set on the server in the encrypted volume only, never in the frontend bundle.
# IMS_PERSISTENCE=hosted-sql
# OP_SQL_HOST=127.0.0.1
# OP_SQL_PORT=11433
# OP_SQL_TLS_NAME=localhost
# OP_SQL_CA_PATH=/etc/receiving-sql/ca.pem
# OP_IDENTITY_SQL_PASSWORD_FILE=/path/to/identity-password
# OP_CONFIG_KEY_FILE=/path/to/32-byte-hex-config-key
# OP_STORE_LOGIN_KEY_FILE=/path/to/32-byte-hex-store-login-key
