[Unit]
Description=Provision uninitialized SQL databases for new receiving stores
Requires=receiving-sql.service
After=receiving-sql.service
ConditionPathIsMountPoint=/srv/receiving-sql

[Service]
Type=oneshot
WorkingDirectory=/opt/receiving-workbench-sql
EnvironmentFile=/srv/receiving-sql/app.env
Environment=OP_SQL_ADMIN_PASSWORD_FILE=/srv/receiving-sql/private/sa-password
ExecStart=/usr/bin/node --import tsx scripts/provisionHostedSql.ts sync-stores
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
